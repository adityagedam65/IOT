# Local environment configuration for the Create React App frontend.
#
# Do not define NODE_ENV here. Create React App supplies it automatically:
# "development" for `npm start` and "production" for `npm run build`.

# Enables the optional /health and /healthz development-server endpoints.
ENABLE_HEALTH_CHECK=false

# Keeps the Emergent development error overlay enabled. Set to true only if it
# causes a local development-server issue.
DISABLE_EMERGENT_OVERLAY=false

# Add any browser-exposed application settings below. Create React App only
# exposes variables whose names start with REACT_APP_, for example:
# REACT_APP_API_URL=http://localhost:8000
